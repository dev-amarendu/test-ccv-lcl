# ──────────────────────────────────────────────
# CCV (Cox Code Vulnerability) — .env.example
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────

# ── Firestore ─────────────────────────────────
FIRESTORE_PROJECT_ID=<<GOOGLE_CLOUD_PROJECT>>
FIRESTORE_DATABASE=(default)

# ── Cloud Pub/Sub ─────────────────────────────
PUBSUB_PROJECT_ID=<<GOOGLE_CLOUD_PROJECT>>
PUBSUB_TOPIC_ANALYZE_FINDING=ccv-analyze-finding
PUBSUB_TOPIC_RUN_SCAN=ccv-run-scan
PUBSUB_TOPIC_SYNC_VERACODE=ccv-sync-veracode
PUBSUB_TOPIC_EMBED_KB=ccv-embed-kb

# ── Vertex AI Vector Search ──────────────────
VECTOR_SEARCH_INDEX_ENDPOINT=<<VECTOR_SEARCH_INDEX_ENDPOINT>>
VECTOR_SEARCH_INDEX_ID=<<VECTOR_SEARCH_INDEX_ID>>
VECTOR_SEARCH_DEPLOYED_INDEX_ID=<<VECTOR_SEARCH_DEPLOYED_INDEX_ID>>

# ── API Service ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8008
API_LOG_LEVEL=info
API_BASE_URL=http://localhost:8008

# ── MCP Server ────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_INTERNAL_TOKEN=<<MCP_INTERNAL_TOKEN>>

# ── Veracode ──────────────────────────────────
VERACODE_ANALYSIS_BASE=https://analysiscenter.veracode.com
VERACODE_REST_BASE=https://api.veracode.com
VERACODE_API_KEY_ID=<<VERACODE_API_KEY_ID>>
VERACODE_API_KEY_SECRET=<<VERACODE_API_KEY_SECRET>>
VERACODE_APP_ID=

# ── Veracode Periodic Sync ────────────────────
VERACODE_SYNC_INTERVAL_SECONDS=300

# ── Bitbucket (optional) ─────────────────────
BITBUCKET_ENABLED=false
BITBUCKET_BASE_URL=<<BITBUCKET_BASE_URL>>
BITBUCKET_PROJECT=<<BITBUCKET_PROJECT>>
BITBUCKET_TOKEN=<<BITBUCKET_TOKEN>>

# ── Git / Repo Fetcher ────────────────────────
REPO_CLONE_URL_TEMPLATE=<<REPO_CLONE_URL_TEMPLATE>>
GIT_USERNAME=<<GIT_USERNAME>>
GIT_PASSWORD_OR_TOKEN=<<GIT_PASSWORD_OR_TOKEN>>

# ── Google Cloud / Vertex AI / ADK ───────────
# ADK reads these env vars to configure the Vertex AI Gemini backend.
GOOGLE_CLOUD_PROJECT=<<GOOGLE_CLOUD_PROJECT>>
GOOGLE_CLOUD_LOCATION=<<GOOGLE_CLOUD_LOCATION>>
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=<<PATH_TO_SA_JSON>>

# ── LLM / Embeddings ─────────────────────────
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBED_DIM=3072

# ── KB ────────────────────────────────────────
CWE_660_CSV_PATH=<<CWE_660_CSV_PATH>>

# ── Feature flags ─────────────────────────────
BACKEND_MOCK_MODE=false

# ── Scan Runner ───────────────────────────────
SCAN_POLL_INTERVAL_SECONDS=30
SCAN_POLL_MAX_ATTEMPTS=120

# ── Analysis Agent ────────────────────────────
ANALYSIS_POLL_INTERVAL_SECONDS=5
